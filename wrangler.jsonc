{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poke-webhook",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    "POKE_API_URL": "https://poke.com/api/v1/inbound/api-message",
    "SLACK_IGNORED_USER_ID": "U01D45GTXRB"
  },
  "previews": {
    "vars": {
      "POKE_API_URL": "https://poke.com/api/v1/inbound/api-message",
      "SLACK_IGNORED_USER_ID": "U01D45GTXRB"
    }
  }
}
