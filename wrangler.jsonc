{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poke-webhook",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    "POKE_API_URL": "https://poke.com/api/v1/inbound/api-message",
    "SLACK_DM_DEBOUNCE_SECONDS": "60"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SLACK_DM_BUFFER", "class_name": "SlackDebounceBuffer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_classes": ["SlackDebounceBuffer"] }
  ],
  "previews": {
    "vars": {
      "POKE_API_URL": "https://poke.com/api/v1/inbound/api-message"
    }
  }
}
