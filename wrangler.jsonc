{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poke-webhook",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    "POKE_API_URL": "https://poke.com/api/v1/inbound/api-message",
    "WEBHOOK_SECRET_HEADER": "X-Webhook-Secret"
  }
}
